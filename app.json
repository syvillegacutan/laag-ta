{
  "expo": {
    "name": "Laag Ta!",
    "slug": "laag-ta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ff6b2b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syvillegacutan.laagta",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Laag Ta! uses your location to find exciting places nearby.",
        "NSLocationAlwaysUsageDescription": "Laag Ta! uses your location to find exciting places nearby.",
        "NSMicrophoneUsageDescription": "Laag Ta! uses your microphone for voice translation.",
        "NSSpeechRecognitionUsageDescription": "Laag Ta! uses speech recognition to translate your voice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ff6b2b"
      },
      "package": "com.syvillegacutan.laagta",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY_HERE"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-location",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Laag Ta! to access your microphone for voice translation."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e9d17434-3689-4f29-b185-4f7cb184361a"
      }
    },
    "owner": "syvillegacutan"
  }
}
