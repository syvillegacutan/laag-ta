# Laag Ta! App Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (development)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Backend API URL (production - replace with your Vercel URL)
# EXPO_PUBLIC_API_URL=https://laagta-backend.vercel.app

# Google Maps API Key (for react-native-maps on Android)
# Get yours at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
